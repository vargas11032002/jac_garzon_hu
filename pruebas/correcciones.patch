+// Deja pasar solo valores escalares del body y descarta campos sensibles.
+// Evita la "asignación masiva": que un cliente envíe { jac: { connect: { id } } },
+// { cuotas: { deleteMany: {} } }, "id", etc. y Prisma lo ejecute como escritura anidada.
+const PROHIBIDOS = new Set(["id", "jac", "jacId", "afiliado", "afiliadoId", "cuotas", "password", "createdAt", "updatedAt"]);
+
+export function soloCamposEscalares(body: Record<string, unknown> | null | undefined): Record<string, unknown> {
+  const salida: Record<string, unknown> = {};
+  for (const [clave, valor] of Object.entries(body ?? {})) {
+    if (PROHIBIDOS.has(clave)) continue;
+    if (valor !== null && typeof valor === "object") continue; // bloquea {connect}, {create}, arrays, etc.
+    salida[clave] = valor;
+  }
+  return salida;
+}
